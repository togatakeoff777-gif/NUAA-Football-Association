# SQLite URL. Use a dedicated local database in development and an absolute file URL in production.
DATABASE_URL=

# scrypt hash of the administrator password. Generate outside Git with npm run security:hash-password.
REFEREE_ADMIN_PASSWORD_HASH=

# Independent random secrets of at least 32 characters. Never reuse or commit real values.
REFEREE_ADMIN_SESSION_SECRET=
REFEREE_MEMBER_SESSION_SECRET=
