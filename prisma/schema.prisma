generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum CompetitionFormat {
  ELEVEN_A_SIDE
  FUTSAL
}

enum CompetitionStatus {
  PREPARING
  REGISTRATION
  ONGOING
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ApplicationWindowStatus {
  OPEN
  CLOSED
}

enum RefereeStatus {
  PENDING
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  NOT_SELECTED
  APPOINTED
  WITHDRAWN
}

enum AppointmentStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum AppointmentPositionKey {
  REFEREE
  ASSISTANT_REFEREE_1
  ASSISTANT_REFEREE_2
  FOURTH_OFFICIAL
  RESERVE_ASSISTANT_REFEREE
  SECOND_REFEREE
  THIRD_REFEREE
  TIMEKEEPER
  FOURTH_REFEREE
}

model Competition {
  id         String            @id @default(cuid())
  slug       String            @unique
  name       String
  year       Int?
  campus     String
  format     CompetitionFormat
  status     CompetitionStatus
  isTestData Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  teams      Team[]
  matches    Match[]
}

model Team {
  id            String      @id @default(cuid())
  competitionId String
  name          String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homeMatches   Match[]     @relation("HomeTeam")
  awayMatches   Match[]     @relation("AwayTeam")

  @@unique([competitionId, name])
  @@index([competitionId])
}

model Match {
  id                      String                     @id @default(cuid())
  slug                    String                     @unique
  competitionId           String
  stage                   String
  kickoff                 DateTime
  venue                   String
  homeTeamId              String
  awayTeamId              String
  homeScore               Int?
  awayScore               Int?
  status                  MatchStatus
  applicationWindowStatus ApplicationWindowStatus    @default(CLOSED)
  applicationDeadline     DateTime?
  publicNote              String?
  internalNote            String?
  cancelledAt             DateTime?
  cancellationReason      String?
  isTestData              Boolean                    @default(false)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  competition             Competition                @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homeTeam                Team                       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam                Team                       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  applications            RefereeApplication[]
  appointment             RefereeAppointment?
  positionRequirements    MatchPositionRequirement[]

  @@index([competitionId, kickoff])
  @@index([applicationWindowStatus, applicationDeadline])
}

model Referee {
  id                     String                @id @default(cuid())
  publicCode             String                @unique
  name                   String
  status                 RefereeStatus         @default(ACTIVE)
  elevenASide            Boolean               @default(false)
  futsal                 Boolean               @default(false)
  sourceNote             String?
  passwordHash           String?
  mustChangePassword     Boolean               @default(true)
  certificateNote        String?
  trainingStatus         TrainingStatus        @default(NOT_STARTED)
  publicDirectoryEnabled Boolean               @default(false)
  publicBio              String?
  internalNote           String?
  failedLoginCount       Int                   @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  passwordChangedAt      DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  applications           RefereeApplication[]
  positions              AppointmentPosition[]
  sessions               RefereeSession[]
}

model MatchPositionRequirement {
  id        String                 @id @default(cuid())
  matchId   String
  key       AppointmentPositionKey
  label     String
  count     Int                    @default(1)
  sortOrder Int
  match     Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, key])
  @@index([matchId, sortOrder])
}

model RefereeApplication {
  id                 String            @id @default(cuid())
  matchId            String
  refereeId          String
  preferredPositions String
  note               String?
  status             ApplicationStatus @default(PENDING)
  reviewNote         String?
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  match              Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  referee            Referee           @relation(fields: [refereeId], references: [id], onDelete: Restrict)

  @@unique([matchId, refereeId])
  @@index([status, createdAt])
}

model RefereeAppointment {
  id               String                @id @default(cuid())
  matchId          String                @unique
  status           AppointmentStatus     @default(DRAFT)
  publicationNote  String?
  publishedAt      DateTime?
  withdrawnAt      DateTime?
  revision         Int                   @default(0)
  lastChangeReason String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  match            Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  positions        AppointmentPosition[]
  versions         AppointmentVersion[]

  @@index([status, publishedAt])
}

model AppointmentPosition {
  id            String                 @id @default(cuid())
  appointmentId String
  refereeId     String?
  key           AppointmentPositionKey
  label         String
  sortOrder     Int
  slot          Int                    @default(1)
  appointment   RefereeAppointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  referee       Referee?               @relation(fields: [refereeId], references: [id], onDelete: SetNull)

  @@unique([appointmentId, key, slot])
  @@index([refereeId])
}

model AppointmentVersion {
  id            String             @id @default(cuid())
  appointmentId String
  revision      Int
  status        AppointmentStatus
  snapshot      String
  reason        String?
  createdAt     DateTime           @default(now())
  appointment   RefereeAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, revision])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model LoginAttempt {
  id           String    @id @default(cuid())
  scope        String
  keyHash      String
  failures     Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([scope, keyHash])
  @@index([blockedUntil])
}

model AdminSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([expiresAt])
}

model RefereeSession {
  id         String   @id @default(cuid())
  refereeId  String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  referee    Referee  @relation(fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([refereeId])
  @@index([expiresAt])
}
